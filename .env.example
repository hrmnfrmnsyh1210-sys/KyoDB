# ==============================================================================
# KyoDB — Smart Database & Cloud Storage Manager
# Environment Configuration Template
# ==============================================================================

# Public App Variables (Exposed to Client)
NUXT_PUBLIC_APP_NAME=KyoDB
NUXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# TiDB Cloud (Structured Data Storage & System Metadata)
# ------------------------------------------------------------------------------
# Hostname provided in TiDB Cloud cluster overview (e.g. gateway01.us-west-2.prod.aws.tidbcloud.com)
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
# Dedicated internal database for metadata (default: kyodb_system)
TIDB_DATABASE=kyodb_system
# Path to SSL CA certificate if custom certificate bundle is required
TIDB_SSL_CA=

# ------------------------------------------------------------------------------
# Cloudflare R2 (Object Storage for Files, Media & SQL Backups)
# ------------------------------------------------------------------------------
# Cloudflare Account ID from R2 Overview dashboard
R2_ACCOUNT_ID=
# S3 API Token credentials generated in R2 API Tokens dashboard
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Name of the private R2 bucket for KyoDB
R2_BUCKET_NAME=
# Custom R2 S3 Endpoint (Optional, defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=

# ------------------------------------------------------------------------------
# Security & Administrative Bootstrap
# ------------------------------------------------------------------------------
# High-entropy random secret for session encryption (at least 32 characters)
SESSION_SECRET=
# Initial master admin bootstrap defaults
ADMIN_BOOTSTRAP_EMAIL=admin@kyodb.local
ADMIN_BOOTSTRAP_PASSWORD=Admin@KyoDB2026!
